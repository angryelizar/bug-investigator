# Happy path on the demo stand resourceBooking: `cp .env.example .env`, fill in the two keys.

# Target Repository: the demo stand. Without push rights to it, use your fork's URL.
BI_TARGET_REPO=https://github.com/angryelizar/resourceBooking.git
BI_TARGET_BRANCH=main

# The model the defense scenarios were run on. Free Groq tiers hit the tokens-per-minute
# limit mid-Investigation: use OpenAI or a paid Groq tier.
BI_PROVIDER=openai
BI_MODEL=gpt-6.2-sol
OPENAI_API_KEY=

# LangSmith traces: one Thread per Investigation.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bug-investigator

# GitHub (issues, comments, Fix PR) goes through the `gh` CLI: run `gh auth login`.

# --- Optional, defaults shown ---
# BI_PROVIDER=groq
# BI_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=
# BI_TEMPERATURE=            # unset: reasoning models reject it
# BI_MAX_TOOL_CALLS=15
# BI_MAX_ATTEMPTS=3
# BI_MAX_OUTPUT_CHARS=6000
# BI_MAX_RETRIES=4
# BI_REQUEST_TIMEOUT_S=60
# BI_BUILD_TIMEOUT_S=300
