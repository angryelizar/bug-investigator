# Target Repository (only repositories from the stand config are run, ADR 0002)
BI_TARGET_REPO=https://github.com/<owner>/resourceBooking.git
BI_TARGET_BRANCH=main

# Provider and model: groq for development, openai for final runs
BI_PROVIDER=groq
BI_MODEL=openai/gpt-oss-120b
# BI_PROVIDER=openai
# BI_MODEL=gpt-5-mini

# Optional: unset by default, reasoning models reject it
# BI_TEMPERATURE=0

# Limits (defaults shown)
# BI_MAX_TOOL_CALLS=15
# BI_MAX_ATTEMPTS=3
# BI_MAX_OUTPUT_CHARS=6000
# BI_MAX_RETRIES=4
# BI_BUILD_TIMEOUT_S=300

# Secrets: read from the environment by the SDKs, never stored in state
GROQ_API_KEY=
OPENAI_API_KEY=

# LangSmith tracing, on from the first run
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bug-investigator
